# Copy to .env and fill in. Never commit .env.

# Portal
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me            # used only when the admin user is first created
# HTTPS_ONLY=true                   # set when serving behind HTTPS

# Oracle (read-only account recommended)
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=host:1521/service_name

# Claude
ANTHROPIC_API_KEY=

# SMTP
SMTP_USER=
SMTP_PASSWORD=

# Optional overrides
# APP_DB_URL=sqlite:///data/app.db  (or postgresql+psycopg://user:pw@host/db)
# OUTPUT_DIR=output
# CONFIG_PATH=config/config.yaml
